diff --git a/lib/kokkos/bin/nvcc_wrapper b/lib/kokkos/bin/nvcc_wrapper
--- a/lib/kokkos/bin/nvcc_wrapper
+++ b/lib/kokkos/bin/nvcc_wrapper
@@ -431,12 +431,19 @@ do
     ;;
 
   #Handle -arch argument (if its not set use a default) this is the version with = sign
-  -arch=*|-gencode=*)
+  -gencode=*)
+    # A CUDA fat binary needs one -gencode option per virtual architecture.
+    # Kokkos normally supplies only one architecture, but downstream targets
+    # may request several native cubins plus a final PTX fallback.
+    arch_set=1
+    cuda_args="$cuda_args $1"
+    ;;
+  -arch=*)
     if [ "$arch_set" -eq 0 ]; then
         arch_set=1
         arch_flag="$1"
         cuda_args="$cuda_args $arch_flag"
-    elif [  "$arch_flag" != "$1" ]; then
+    elif [ "$arch_flag" != "$1" ]; then
         echo "ARCH is being set twice with different flags, which is not handled"
         echo "$arch_flag"
         echo "$1"
@@ -444,7 +451,12 @@ do
     fi
     ;;
   #Handle -arch argument (if its not set use a default) this is the version without = sign
-  -arch|-gencode)
+  -gencode)
+    arch_set=1
+    cuda_args="$cuda_args $1 $2"
+    shift
+    ;;
+  -arch)
     if [ "$arch_set" -eq 0 ]; then
         arch_set=1
         arch_flag="$1 $2"
diff --git a/lib/kokkos/cmake/kokkos_arch.cmake b/lib/kokkos/cmake/kokkos_arch.cmake
--- a/lib/kokkos/cmake/kokkos_arch.cmake
+++ b/lib/kokkos/cmake/kokkos_arch.cmake
@@ -813,10 +813,33 @@ function(CHECK_CUDA_ARCH ARCH FLAG)
       if(KOKKOS_ENABLE_COMPILE_AS_CMAKE_LANGUAGE)
         set(CMAKE_CUDA_ARCHITECTURES ${KOKKOS_CUDA_ARCHITECTURES} PARENT_SCOPE)
       else()
-        global_append(KOKKOS_CUDA_OPTIONS "${CUDA_ARCH_FLAG}=${FLAG}")
-        if(KOKKOS_ENABLE_CUDA_RELOCATABLE_DEVICE_CODE OR KOKKOS_CXX_COMPILER_ID STREQUAL NVIDIA)
-          global_append(KOKKOS_LINK_OPTIONS "${CUDA_ARCH_FLAG}=${FLAG}")
-        endif()
+        if(Kokkos_CUDA_FATBIN_ARCHITECTURES)
+          # Keep one Kokkos logical architecture while emitting native cubins
+          # for every requested CUDA target. Only the newest virtual
+          # architecture is retained as PTX for forward compatibility.
+          list(GET Kokkos_CUDA_FATBIN_ARCHITECTURES -1 KOKKOS_CUDA_PTX_ARCH)
+          foreach(KOKKOS_CUDA_FATBIN_ARCH IN LISTS Kokkos_CUDA_FATBIN_ARCHITECTURES)
+            if(KOKKOS_CUDA_FATBIN_ARCH STREQUAL KOKKOS_CUDA_PTX_ARCH)
+              set(KOKKOS_CUDA_FATBIN_CODE
+                  "[sm_${KOKKOS_CUDA_FATBIN_ARCH},compute_${KOKKOS_CUDA_FATBIN_ARCH}]")
+            else()
+              set(KOKKOS_CUDA_FATBIN_CODE "sm_${KOKKOS_CUDA_FATBIN_ARCH}")
+            endif()
+            set(KOKKOS_CUDA_FATBIN_FLAG
+                "-gencode=arch=compute_${KOKKOS_CUDA_FATBIN_ARCH},code=${KOKKOS_CUDA_FATBIN_CODE}")
+            global_append(KOKKOS_CUDA_OPTIONS "${KOKKOS_CUDA_FATBIN_FLAG}")
+            if(KOKKOS_ENABLE_CUDA_RELOCATABLE_DEVICE_CODE
+               OR KOKKOS_CXX_COMPILER_ID STREQUAL NVIDIA)
+              global_append(KOKKOS_LINK_OPTIONS "${KOKKOS_CUDA_FATBIN_FLAG}")
+            endif()
+          endforeach()
+        else()
+          global_append(KOKKOS_CUDA_OPTIONS "${CUDA_ARCH_FLAG}=${FLAG}")
+          if(KOKKOS_ENABLE_CUDA_RELOCATABLE_DEVICE_CODE
+             OR KOKKOS_CXX_COMPILER_ID STREQUAL NVIDIA)
+            global_append(KOKKOS_LINK_OPTIONS "${CUDA_ARCH_FLAG}=${FLAG}")
+          endif()
+        endif()
       endif()
     endif()
   endif()
